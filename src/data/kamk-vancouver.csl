<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="fi-FI">
  <info>
    <title>KAMK Vancouver</title>
    <id>https://github.com/sourander/kamk-thesis-typst/raw/refs/heads/main/src/data/kamk-vancouver.csl</id>
    <updated>2026-09-07T00:00:00+00:00</updated>
    <link href="https://libguides.kamk.fi/vancouver" rel="documentation"/>
  </info>

  <!-- Custom local overrides for the Finnish dictionary -->
  <locale xml:lang="fi">
    <terms>
      <term name="available at">saatavilla</term>
      <term name="accessed">viitattu</term>
    </terms>
  </locale>

  <!-- Formats inline citations as [1] or [1, Luku 4] -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter="; ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", "/>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", "/>
      <label form="short" prefix=", "/>
    </names>
  </macro>

  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <bibliography second-field-align="flush">
    <layout>
      <text variable="citation-number" suffix=". "/>
      
      <!-- Smart Grouping: Automatically handles trailing periods -->
      <group delimiter=". " suffix=".">
        <text macro="author"/>

        <choose>
          <!-- Book -->
          <if type="book">
            <group delimiter=". ">
              <group delimiter=" ">
                <text variable="title" font-style="italic"/>
                <text variable="medium" prefix="[" suffix="]"/>
              </group>
              <text variable="edition"/>
              <group delimiter=" ">
                <text variable="collection-title"/>
                <text variable="collection-number"/>
              </group>
              <group delimiter="; ">
                <text macro="publisher"/>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
              </group>
            </group>
          </if>
          
          <!-- Journal Article -->
          <else-if type="article-journal">
            <text variable="title" font-style="italic"/>
            <group delimiter=" ">
              <text variable="container-title"/>
              <group>
                <date variable="issued" suffix=";">
                  <date-part name="year"/>
                </date>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
                <text variable="page" prefix=", "/>
              </group>
            </group>
          </else-if>

          <!-- Book Section (Chapter) -->
          <else-if type="chapter">
            <text variable="title" font-style="italic"/>
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first" suffix=":"/>
              <text macro="editor"/>
            </group>
            <text variable="container-title"/>
            <group delimiter="; ">
              <text macro="publisher"/>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
            <text variable="page"/>
          </else-if>

          <!-- Thesis -->
          <else-if type="thesis">
            <group delimiter=" ">
              <text variable="title" font-style="italic"/>
              <choose>
                <if variable="genre">
                  <text variable="genre" prefix="[" suffix="]"/>
                </if>
                <else>
                  <text value="[Opinnäytetyö]"/>
                </else>
              </choose>
            </group>
            <group delimiter="; ">
              <text macro="publisher"/>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
          </else-if>

          <!-- Legislation & Standards (Law, Reports) -->
          <else-if type="legislation report bill" match="any">
            <text variable="title" font-style="italic"/>
            <group delimiter=". ">
              <text macro="publisher"/>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
          </else-if>

          <!-- FAILSAFE FALLBACK (Typst @unpublished) -->
          <!-- Prints absolutely nothing but the title string. Useful if a student needs a quick hack. -->
          <else-if type="manuscript">
            <text variable="title" font-style="italic"/>
          </else-if>

          <!-- UNIVERSAL DIGITAL & AV MEDIA (Webpages, Podcasts, Games, Videos, Emails, Intranet) -->
          <else-if type="webpage post-weblog post software dataset motion_picture broadcast song speech personal_communication" match="any">
            <group delimiter=". ">
              <group delimiter=" ">
                <text variable="title" font-style="italic"/>
                <choose>
                  <if variable="medium">
                    <!-- Enables [Podcast], [Intranet], [Sähköposti], [Mobiilipeli] dynamically -->
                    <text variable="medium" prefix="[" suffix="]"/>
                  </if>
                  <else-if variable="genre">
                    <text variable="genre" prefix="[" suffix="]"/>
                  </else-if>
                  <else-if type="dataset">
                    <text value="[Tilasto]"/>
                  </else-if>
                  <else-if type="webpage post-weblog">
                    <text value="[Internet]"/>
                  </else-if>
                </choose>
              </group>
              
              <!-- container-title captures things like "Yle Areena" or "Youtube" -->
              <text variable="container-title"/>
              <text variable="publisher"/>
              
              <!-- Date formatting changed to form="numeric" to output 3.1.2023 instead of 03.01.2023 -->
              <group delimiter=" ">
                <date variable="issued">
                  <date-part name="day" form="numeric" suffix="."/>
                  <date-part name="month" form="numeric" suffix="."/>
                  <date-part name="year"/>
                </date>
                <group prefix="[" suffix="]">
                  <text term="accessed" suffix=" "/>
                  <date variable="accessed">
                    <date-part name="day" form="numeric" suffix="."/>
                    <date-part name="month" form="numeric" suffix="."/>
                    <date-part name="year"/>
                  </date>
                </group>
              </group>
            </group>
          </else-if>
          
          <!-- Catch-all for anything else not defined above -->
          <else>
             <group delimiter=". ">
                <text variable="title" font-style="italic"/>
                <text macro="publisher"/>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
             </group>
          </else>

        </choose>

        <!-- Notes (like "Celia äänikirjapalvelu" or "Valitut muuttujat") -->
        <text variable="note"/>
        
        <group delimiter=" ">
          <text term="available at" text-case="capitalize-first" suffix=":"/>
          <text variable="URL"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
